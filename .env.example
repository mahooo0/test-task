# ──────────────────────────────────────────────────────────────
# Copy the two sections below into apps/api/.env (backend) and
# apps/web/.env.local (frontend), and fill in real values.
# Never commit real secrets. Clerk keys come from the Clerk dashboard.
# ──────────────────────────────────────────────────────────────

# ===== Backend (apps/api/.env) =====

NODE_ENV=development
PORT=3000

# Postgres — matches docker-compose.yml for local dev
DATABASE_URL="postgresql://dataroom:dataroom@localhost:5432/dataroom?schema=public"

# Comma-separated allowlist of browser origins (the web app) for CORS
CORS_ORIGIN="http://localhost:3001"

# Clerk — the API verifies session tokens with the secret key
CLERK_SECRET_KEY="sk_test_..."

# Cloudflare R2 (S3-compatible blob storage) — wired up in the Files feature
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dataroom"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Seconds a presigned upload/download URL stays valid
R2_PRESIGN_EXPIRES=900

# ===== Frontend (apps/web/.env.local) — Next.js =====

# Publishable key is public (safe in the client bundle)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# Base URL of the Nest API (the browser calls it with a Clerk bearer token)
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Custom auth routes (used by Clerk proxy + provider redirects)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Server-only — Clerk's Next proxy verifies sessions server-side. NOT exposed to the client.
CLERK_SECRET_KEY="sk_test_..."

# PostHog (analytics + session replay). The project token is public (ships in the bundle);
# without it PostHog is simply disabled (a console.error reminds you in dev).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_..."
